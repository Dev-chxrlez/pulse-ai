PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Relative to server working directory
DATA_DIR=./data
# Backend only. Add your own key; never commit server/.env.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
MAX_ANALYSIS_SECONDS=180
# Optional absolute paths if FFmpeg is not discoverable.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Opt-in local read-only transfer; never a social collector.
# SOCIALMONITOR_LOCAL_ROOT=/Users/apple/Desktop/SocialMonitor
# Optional if SocialMonitor uses a nondefault database location:
# SOCIALMONITOR_LOCAL_DATABASE=/absolute/path/to/socialmonitor.db

# Optional trusted absolute yt-dlp binary path; defaults to server/.tools/yt-dlp/bin/yt-dlp
# YTDLP_PATH=/absolute/path/to/yt-dlp
