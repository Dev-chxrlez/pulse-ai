{
  "name": "pulse-ai",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "lint": "eslint client/src server/src server/test scripts",
    "test": "npm test -w server",
    "check": "node scripts/check.mjs",
    "demo": "npm run build && node scripts/start-demo.mjs",
    "tiktok:status": "node scripts/tiktok-official.mjs status",
    "tiktok:acquire": "node scripts/tiktok-official.mjs acquire"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.5.0"
  }
}
